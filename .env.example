# ─────────── server ───────────
PORT=3000
# In Docker/Coolify this MUST be 0.0.0.0 (the default). Only use 127.0.0.1
# for a bare-metal install behind a local reverse proxy.
HOST=0.0.0.0
BASE_PATH=/chatbotadmin
PUBLIC_URL=https://ccadmin.online

# Random 64-char string. Generate: openssl rand -hex 32
SESSION_SECRET=change_me_openssl_rand_hex_32

# ─────────── admin login ───────────
ADMIN_EMAIL=you@example.com
# Generate with: npm run hash -- "your-password"
ADMIN_PASSWORD_HASH=

# ─────────── AI providers ───────────
# Primary. Get free key at https://aistudio.google.com/apikey
# Do NOT enable billing on this Google Cloud project or the free tier disappears.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Fallback (optional). https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ─────────── Meta ───────────
# Any random string you invent; paste the same one into the Meta webhook form.
META_VERIFY_TOKEN=pick_any_random_string
# App Dashboard → Settings → Basic → App Secret
META_APP_SECRET=

# Messenger: Page access token (long-lived)
FB_PAGE_TOKEN=
FB_PAGE_ID=

# Instagram: Instagram Business access token
IG_TOKEN=
IG_USER_ID=

GRAPH_VERSION=v21.0

# Instagram host depends on how you connected the account:
#   Business Login for Instagram (standalone) -> https://graph.instagram.com
#   Instagram linked to a Facebook Page       -> https://graph.facebook.com
IG_GRAPH_HOST=https://graph.instagram.com

# ─────────── Web Push Notifications (PWA) ───────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@ccadmin.online

# ─────────── Database Backup ───────────
# Directory to save daily SQLite snapshots (defaults to ./backups)
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=7

